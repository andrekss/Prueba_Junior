# frontend/Dockerfile

FROM node:18 as build-stage

WORKDIR /
COPY . .
RUN npm install
RUN npm run build


# Fase de producción
FROM nginx:stable-alpine as production-stage

COPY --from=build-stage /dist /usr/share/nginx/html

EXPOSE 80

COPY nginx.conf /etc/nginx/conf.d/default.conf
CMD ["nginx", "-g", "daemon off;"]